-- Raycast from screen center to detect other players
local function getCenterTarget()
	local cam = workspace.CurrentCamera
	local ray = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1000)
	if result and result.Instance then
		for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
			if plr ~= game.Players.LocalPlayer and plr.Character and result.Instance:IsDescendantOf(plr.Character) then
				return plr
			end
		end
	end
	return nil
end

