--// Lock-On Logic
---------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == KeybindKey and Locking then
        if CurrentTarget then
            CurrentTarget = nil
        else
            CurrentTarget = GetClosestPlayer()
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Locking and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild(AimPart) then
        local targetPart = CurrentTarget.Character[AimPart]
        local predictedPos = targetPart.Position + (targetPart.Velocity * Prediction)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
    end
end)
