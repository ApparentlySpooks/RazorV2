			end

			local lp = game.Players.LocalPlayer
			if not lp.Character or not lp.Character:FindFirstChild("Head") then
				stopHolding()
				return
			end

			local target = getCenterTarget()
			if target and target.Character:FindFirstChildOfClass("Humanoid") and target.Character.Humanoid.Health > 0 then
				startHolding()
			else
				stopHolding()
			end
		end)
	end,
})

