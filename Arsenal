local LineThickness = 2
local RigLines = {} -- [playerName] = {Lines = {}, Connections = {}}

-- Clear all lines
local function ClearRigLines()
	for _, playerLines in pairs(RigLines) do
		for _, line in pairs(playerLines.Lines) do
			line:Remove()
		end
	end
	RigLines = {}
end

-- Toggle + Color Picker
local RigToggle = Tab:CreateToggle({
	Name = "Bones ESP",
	CurrentValue = false,
	Flag = "RigVisualizerToggle",
	Callback = function(Value)
		RigVisualizerEnabled = Value
		if not Value then ClearRigLines() end
	end,
})

local RigColorPicker = Tab:CreateColorPicker({
	Name = "Bones Color",
	Color = Color3.fromRGB(255,255,255),
	Flag = "RigVisualizerColor",
	Callback = function(Value)
		RigColor = Value
	end
})

-- Precompute limb connections
local function ComputeRigLines(character)
	local parts = {}
	for _, name in ipairs({
		"Head","Torso","UpperTorso","LowerTorso",
		"LeftArm","RightArm","LeftLeg","RightLeg",
		"LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm",
		"LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg",
		"LeftHand","RightHand","LeftFoot","RightFoot"
	}) do
		local part = character:FindFirstChild(name)
		if part then table.insert(parts, part) end
	end

	local connections = {}
	for _, part in ipairs(parts) do
		for _, joint in ipairs(part:GetJoints()) do
			if joint.Part0 and joint.Part1 then
				table.insert(connections, {joint.Part0, joint.Part1})
			end
		end
	end

	return connections
end

-- Render loop
RunService.RenderStepped:Connect(function()
	if not RigVisualizerEnabled then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character

			-- Setup lines if first time
			if not RigLines[player.Name] then
				local connections = ComputeRigLines(char)
				if #connections == 0 then continue end -- skip if no connections

				local lines = {}
				for i, conn in ipairs(connections) do
					-- Only create line if both parts exist
					if conn[1] and conn[2] then
						local line = Drawing.new("Line")
						line.Thickness = LineThickness
						line.Color = RigColor
						line.Visible = false -- hide initially
						table.insert(lines, line)
					end
				end
				RigLines[player.Name] = {Lines = lines, Connections = connections}
			end

			local data = RigLines[player.Name]
			for i, conn in ipairs(data.Connections) do
				local p0, p1 = conn[1], conn[2]
				local line = data.Lines[i]

				if p0 and p1 and line then
					local s0, onScreen0 = Camera:WorldToViewportPoint(p0.Position)
					local s1, onScreen1 = Camera:WorldToViewportPoint(p1.Position)

					-- Only draw if both points are valid
					if (onScreen0 or onScreen1) then
						line.Visible = true
						line.From = Vector2.new(s0.X, s0.Y)
						line.To = Vector2.new(s1.X, s1.Y)
						line.Color = RigColor
					else
						line.Visible = false
					end
				elseif line then
					line.Visible = false -- hide invalid lines
				end
			end
		end
	end
end)

-- Cleanup when players leave
Players.PlayerRemoving:Connect(function(player)
	if RigLines[player.Name] then
		for _, line in pairs(RigLines[player.Name].Lines) do
			line:Remove()
		end
		RigLines[player.Name] = nil
	end
end)

--// ESP logic
RunService.RenderStepped:Connect(function()
	if not TracerEnabled then return end

	local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
			local name = player.Name

			local line = Tracers[name]
			if not line then
				line = Drawing.new("Line")
				line.Thickness = LineThickness
				line.Color = TracerColor
				Tracers[name] = line
			end

			if onScreen then
				line.Visible = true
				line.From = screenCenter
				line.To = Vector2.new(screenPos.X, screenPos.Y)
				line.Color = TracerColor
			else
				line.Visible = false
			end
		end
	end

	-- Cleanup invisible / missing players
	for name, line in pairs(Tracers) do
		local plr = Players:FindFirstChild(name)
		if not plr or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
			line.Visible = false
		end
	end
end)

--// ESP logic
local function GetCharacterCorners(character)
	local modelCF, modelSize = character:GetBoundingBox()
	local half = modelSize / 2
	local corners = {
		Vector3.new(-half.X,  half.Y, -half.Z),
		Vector3.new( half.X,  half.Y, -half.Z),
		Vector3.new( half.X, -half.Y, -half.Z),
		Vector3.new(-half.X, -half.Y, -half.Z),
		Vector3.new(-half.X,  half.Y,  half.Z),
		Vector3.new( half.X,  half.Y,  half.Z),
		Vector3.new( half.X, -half.Y,  half.Z),
		Vector3.new(-half.X, -half.Y,  half.Z),
	}
	for i, v in ipairs(corners) do
		corners[i] = modelCF:PointToWorldSpace(v)
	end
	return corners
end

RunService.RenderStepped:Connect(function()
	if not ESPEnabled then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local corners = GetCharacterCorners(player.Character)
			local screenCorners, onScreen = {}, false

			for i, v in ipairs(corners) do
				local screenPos, visible = Camera:WorldToViewportPoint(v)
				screenCorners[i] = Vector2.new(screenPos.X, screenPos.Y)
				if visible then onScreen = true end
			end

			local name = player.Name
			local box = Drawings[name]
			if not box then
				box = Drawing.new("Square")
				box.Thickness = BoxThickness
				box.Filled = false
				Drawings[name] = box
			end

			if onScreen then
				local minX, minY = math.huge, math.huge
				local maxX, maxY = -math.huge, -math.huge
				for _, v in ipairs(screenCorners) do
					minX = math.min(minX, v.X)
					minY = math.min(minY, v.Y)
					maxX = math.max(maxX, v.X)
					maxY = math.max(maxY, v.Y)
				end

				box.Visible = true
				box.Color = BoxColor
				box.Position = Vector2.new(minX, minY)
				box.Size = Vector2.new(maxX - minX, maxY - minY)
			else
				box.Visible = false
			end
		end
	end

	-- Cleanup dead players
	for name, box in pairs(Drawings) do
		local plr = Players:FindFirstChild(name)
		if not plr or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
			box.Visible = false
		end
	end
end)


